# ================================
# Web API Environment Variables
# ================================
PORT=4000
NODE_ENV=development
JWT_SECRET=your_key

# Database / Supabase
DATABASE_URL=your_key
SUPABASE_URL=your_key
SUPABASE_SERVICE_ROLE_KEY=your_key

# AI Engine (Groq)
GROQ_API_KEY=your_key
# GROQ_API_KEY_1= for key rotation system
# GROQ_API_KEY_2=your_key
# GROQ_API_KEY_3=your_key

# ================================
# Web App (Frontend) Environment Variables
# ================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api